# AI backend: any OpenAI-compatible endpoint (vLLM, LM Studio, llama.cpp, ...)
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=
VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# VLLM_CONCURRENCY=8          # requests sent at the same time (vLLM batches them; 16 is about twice as fast)
# Ollama: use its native API (only there can the context length be set; Ollama's default rejects 4 images)
# VLLM_BACKEND=ollama
# VLLM_BASE_URL=http://127.0.0.1:11434
# VLLM_MODEL=qwen3-vl:8b-instruct
# VLLM_NUM_CTX=16384          # tokens per request (up to 8 images, ~1040 tokens each); more uses more GPU memory
